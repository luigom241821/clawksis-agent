name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# Desde el sync a Hermes v0.22.5: el lockfile (uv.lock) cubre solo Python 3.14
# (politica de upstream: 3.11-3.13 son solo un puente de actualizacion) y las
# herramientas de dev (ruff, pytest) viven en el dependency group `dev`, que uv
# no instala por defecto (`default-groups = []`). uv va fijado a la version con
# la que upstream genera el lock.

# En un PR, un push nuevo cancela la corrida anterior (las 8 tandas de tests
# son caras y el resultado viejo ya no sirve).
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  lint:
    name: Lint (ruff)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: astral-sh/setup-uv@v7
        with:
          version: "0.13.5"
      - run: uv sync --locked --python 3.14 --group dev
      - run: uv run ruff check .
      - run: uv run ruff format --check .

  test:
    # La suite de upstream tiene ~6.800 archivos de test. Upstream la corre en
    # 2 tandas sobre maquinas de 32 vCPU; aca se reparte en 8 tandas sobre los
    # runners de 4 vCPU (scripts/run_tests_parallel.py reparte con su cache de duraciones).
    name: Tests (${{ matrix.slice }}/8)
    runs-on: ubuntu-latest
    timeout-minutes: 120
    strategy:
      fail-fast: false
      matrix:
        slice: [1, 2, 3, 4, 5, 6, 7, 8]
    steps:
      - uses: actions/checkout@v7.0.1
      # Varias herramientas (search_files) y sus tests usan ripgrep; el runner no lo trae.
      - name: Install ripgrep (prebuilt binary)
        run: |
          set -euo pipefail
          RG_VERSION=15.1.0
          RG_SHA256=1c9297be4a084eea7ecaedf93eb03d058d6faae29bbc57ecdaf5063921491599
          RG_TARBALL=ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz
          curl -sSfL --retry 3 --retry-delay 5 -o "$RG_TARBALL" \
            "https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/${RG_TARBALL}"
          echo "${RG_SHA256}  ${RG_TARBALL}" | sha256sum -c -
          tar -xzf "$RG_TARBALL"
          sudo mv "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg" /usr/local/bin/rg
          rm -rf "$RG_TARBALL" "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl"
          rg --version
      # Entorno de tests aislado de PM (como upstream): interprete del lock + groups dev/test
      # + la matriz de extras de proveedores. Varios tests dependen de correr bajo el
      # interprete del store de PM (filtros de PATH, perfiles), no bajo un venv del checkout.
      # El store de PM y el entorno de tests viven FUERA del HOME real (como el setup-pm de
      # upstream, --home "$RUNNER_TEMP/setup-pm"): el guard de tests rechaza cualquier I/O
      # contra ~/.clawksis, y los tests que usan el uv del PATH lo copian/leen.
      - name: Set up the PM test environment
        run: |
          set -euo pipefail
          echo "CLAWK_CI_HOME=$RUNNER_TEMP/clawk-ci" >> "$GITHUB_ENV"
          CLAWK_HOME="$RUNNER_TEMP/clawk-ci" CLAWK_RUNTIME_DIR="$RUNNER_TEMP/clawk-ci/tools" \
            bash setup-clawk.sh --runtime-only --test-environment=all,anthropic,bedrock,mistral,fal,modal,daytona,parallel-web
      - name: Locate the test interpreter
        env:
          CLAWK_HOME: ${{ env.CLAWK_CI_HOME }}
          CLAWK_RUNTIME_DIR: ${{ env.CLAWK_CI_HOME }}/tools
        run: |
          set -euo pipefail
          boot="$(ls "$CLAWK_RUNTIME_DIR"/python-*/bin/python3 | head -n1)"
          py="$("$boot" -c "import sys; sys.path.insert(0, '.'); from pathlib import Path; from pm.testenv import testenv_python; print(testenv_python(Path('.').resolve()) or '')")"
          test -x "$py"
          "$py" -c "import pytest, anthropic, mistralai" && echo "CLAWK_PYTHON=$py" >> "$GITHUB_ENV"
          # Los tests de pm/ y de empaquetado usan el uv real del lock (como el setup-pm de upstream).
          uvdir="$(ls -d "$CLAWK_RUNTIME_DIR"/uv-*/ | head -n1)"
          test -x "${uvdir}uv"
          echo "${uvdir%/}" >> "$GITHUB_PATH"
      # scripts/run_tests.sh corre cada archivo en su propio subproceso de pytest con un
      # entorno limpio (env -i: sin credenciales, TZ=UTC, sin INVOCATION_ID del runner).
      - name: Run tests
        run: scripts/run_tests.sh
        env:
          CLAWK_TEST_SLICE: ${{ matrix.slice }}/8
          CLAWK_TEST_FILE_TIMEOUT: 600
